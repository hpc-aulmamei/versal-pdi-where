# Write OUT with PDI_WHERE_GIT, the `git describe` of the source tree SRC (empty outside a git
# checkout). Runs on every build; OUT is rewritten only when the description changes, so an
# unchanged tree does not relink.
execute_process(COMMAND git -C "${SRC}" describe --always --dirty --tags
                OUTPUT_VARIABLE desc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    set(desc "")
endif()
file(WRITE "${OUT}.tmp" "// Generated by cmake/git_version.cmake.\n#pragma once\n#define PDI_WHERE_GIT \"${desc}\"\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
